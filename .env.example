# OceanEmbed frontend configuration (copy to .env.local; .env* files are git-ignored).
#
# VITE_API_BASE_URL: optional FastAPI backend URL.
# Leave it unset for the normal case: the dashboard then calls
#   http://<host the page was opened from>:8000
# which works both on http://localhost:3000 and on a LAN address such as
# http://<your-LAN-IP>:3000 without any change.
# Set it only when the backend runs on a different host or port, e.g.:
# VITE_API_BASE_URL=http://192.168.1.20:8000

# OceanEmbed backend configuration (read by backend/config.py from the process environment).
#
# OCEANEMBED_ALLOWED_ORIGINS: optional comma-separated CORS allow-list.
# Defaults to "*" (the API is read-only and uses no cookies/credentials).
# OCEANEMBED_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.20:3000
